<UserControl x:Class="SeapowerUI.DamageControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SeapowerUI"
             mc:Ignorable="d">
    <Grid Margin="6" MinHeight="330">
        <Grid.Resources>
            <local:IntegrityToDamageControlConverter x:Key="IntegrityToDamageControlConverter"/>
            <local:IntegrityPercentageToDamageControlIntegerConverter x:Key="IntegrityPercentageToDamageControlIntegerConverter"/>
            <local:FloodingPercentageToDamageControlStringConverter x:Key="FloodingPercentageToDamageControlStringConverter"/>
            <local:FloodingPercentageToDamageControlIntegerConverter x:Key="FloodingPercentageToDamageControlIntegerConverter"/>

            <Style x:Key="SummaryCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Brush.TextBox.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Normal}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.Foreground.Highlight}"/>
                <Setter Property="FontSize" Value="{StaticResource Font.Size.ToolTip}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextBox.Foreground}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="AutoToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Setter Property="Padding" Value="10,2"/>
                <Setter Property="MinWidth" Value="90"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Summary cards provide quick state without adding another live data projection. -->
        <Grid Grid.Row="0" Margin="0,0,0,6" Panel.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="145"/>
                <ColumnDefinition Width="135"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SummaryLabelStyle}" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolteamsheader], FallbackValue='Damage Control Teams'}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource SummaryValueStyle}" FontSize="{StaticResource Font.Size.Header}" HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="{Binding Compartments.DamageControlTeamsNumbers[5], FallbackValue=0}" Foreground="{StaticResource Brush.TextBox.ForegroundStrongEmphasis}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding Compartments.DamageControlTeamDefaultsNumber, FallbackValue=0}"/>
                    </TextBlock>
                    <TextBlock Grid.Row="2" Style="{StaticResource SummaryLabelStyle}" Margin="0,4,0,0" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolavailabletotal], FallbackValue='Available / Total'}"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SummaryLabelStyle}" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolknockedout], FallbackValue='Teams Knocked Out'}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource SummaryValueStyle}" FontSize="{StaticResource Font.Size.Header}" HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="{Binding KnockedOutDamageControlTeamsCount, FallbackValue=0}" Foreground="{StaticResource Brush.TextBox.ForegroundStrongEmphasis}"/>
                    </TextBlock>
                    <TextBlock Grid.Row="2" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource Brush.Foreground.Highlight}" Margin="0,4,0,0" FontSize="{StaticResource Font.Size.ToolTip}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers><DataTrigger Binding="{Binding KnockedOutDamageControlTeamsCount, FallbackValue=0}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolnextteamreturn], FallbackValue='Available In'}"/><Run Text=": "/><Run Text="{Binding NextDamageControlTeamReturnSeconds, FallbackValue=0}" Foreground="{StaticResource Brush.TextBox.ForegroundFocus}"/><Run Text=" "/><Run Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolsecondsabbr], FallbackValue='s'}"/>
                    </TextBlock>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SummaryLabelStyle}" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolautodamagecontrol], FallbackValue='Auto Damage Control'}"/>
                    <ToggleButton Grid.Row="1" Style="{StaticResource AutoToggleButtonStyle}" IsChecked="{Binding Compartments.AutoDC}" ToolTip="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolautodamagecontrolstatus], FallbackValue='Automatic damage control assigns teams to active threats.'}">
                        <Grid>
                            <TextBlock Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolenabled], FallbackValue='Enabled'}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontroldisabled], FallbackValue='Disabled'}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ToggleButton>
                </Grid>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolhulldamage], FallbackValue='Hull Damage:'}"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="5,0" Background="{StaticResource Brush.TextBox.Background}" Text="{Binding Compartments.IntegrityPercentage, Converter={StaticResource IntegrityToDamageControlConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextBox.Foreground}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Compartments.IntegrityPercentage, Converter={StaticResource IntegrityPercentageToDamageControlIntegerConverter}}" Value="1"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundFocus}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Compartments.IntegrityPercentage, Converter={StaticResource IntegrityPercentageToDamageControlIntegerConverter}}" Value="2"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundEmphasis}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Compartments.IntegrityPercentage, Converter={StaticResource IntegrityPercentageToDamageControlIntegerConverter}}" Value="3"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundStrongEmphasis}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Compartments.IntegrityPercentage, Converter={StaticResource IntegrityPercentageToDamageControlIntegerConverter}}" Value="4"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundReallyStrongEmphasis}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolflooding], FallbackValue='Flooding:'}"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="5,0" Background="{StaticResource Brush.TextBox.Background}" Text="{Binding Compartments.FloodingPercentage, Converter={StaticResource FloodingPercentageToDamageControlStringConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextBox.Foreground}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Compartments.FloodingPercentage, Converter={StaticResource FloodingPercentageToDamageControlIntegerConverter}}" Value="1"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundFocus}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Compartments.FloodingPercentage, Converter={StaticResource FloodingPercentageToDamageControlIntegerConverter}}" Value="2"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundEmphasis}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Compartments.FloodingPercentage, Converter={StaticResource FloodingPercentageToDamageControlIntegerConverter}}" Value="3"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundStrongEmphasis}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Compartments.FloodingPercentage, Converter={StaticResource FloodingPercentageToDamageControlIntegerConverter}}" Value="4"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundReallyStrongEmphasis}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,-30,0,6" Padding="0" Panel.ZIndex="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="1" Stretch="Uniform" Margin="5" MaxHeight="256" MaxWidth="330" VerticalAlignment="Top">
                <Image.Source>
                    <MultiBinding Converter="{StaticResource IniToProfileConverter}">
                        <Binding Path="IniRef" FallbackValue=""/>
                        <Binding Path="VariantIndex" FallbackValue="0"/>
                    </MultiBinding>
                </Image.Source>
            </Image>
            <Grid Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontroldcteams], FallbackValue='DC Teams:'}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" IsEnabled="False" Background="{StaticResource Brush.TextBox.Background}" Padding="5,0">
                    <TextBlock.Resources>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Compartments.DamageControlTeamsNumbers[5], FallbackValue=0}" Value="0">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundStrongEmphasis}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Resources>
                    <Run Text="{Binding Compartments.DamageControlTeamsNumbers[5], FallbackValue=0}"/>/<Run Text="{Binding Compartments.DamageControlTeamDefaultsNumber, FallbackValue=0}"/>
                </TextBlock>
                <ToggleButton Grid.Row="0" Grid.Column="4"
                              Content="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolauto], FallbackValue='Auto'}"
                              Padding="5,0"
                              IsChecked="{Binding Compartments.AutoDC}"
                              ToolTip="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolautodamagecontrolstatus], FallbackValue='Automatic damage control assigns teams to active threats.'}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolnextteamreturn], FallbackValue='Available In'}"/>
                <TextBlock Grid.Row="2" Grid.Column="2"
                           IsEnabled="False"
                           Background="{StaticResource Brush.TextBox.Background}"
                           Padding="5,0"
                           TextAlignment="Center"
                           MinWidth="40"
                           ToolTip="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolknockedout], FallbackValue='Teams currently unavailable'}">
                    <Run Text="{Binding NextDamageControlTeamReturnSeconds}"/><Run Text=" "/><Run Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolsecondsabbr], FallbackValue='s'}"/>
                </TextBlock>
            </Grid>
            <Grid Grid.Column="2" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5,5,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolhulldamage], FallbackValue='Hull Damage:'}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Padding="5,0" Text="{Binding Compartments.IntegrityPercentage, Converter={StaticResource IntegrityToDamageControlConverter}}">
                    <TextBlock.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="5,0"/>
                            <Setter Property="MinWidth" Value="80"/>
                            <Setter Property="Background" Value="{StaticResource Brush.TextBox.Background}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Compartments.IntegrityPercentage, Converter={StaticResource IntegrityPercentageToDamageControlIntegerConverter}}" Value="1"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundFocus}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Compartments.IntegrityPercentage, Converter={StaticResource IntegrityPercentageToDamageControlIntegerConverter}}" Value="2"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundEmphasis}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Compartments.IntegrityPercentage, Converter={StaticResource IntegrityPercentageToDamageControlIntegerConverter}}" Value="3"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundStrongEmphasis}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Compartments.IntegrityPercentage, Converter={StaticResource IntegrityPercentageToDamageControlIntegerConverter}}" Value="4"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundReallyStrongEmphasis}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Resources>
                </TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolflooding], FallbackValue='Flooding:'}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Compartments.FloodingPercentage, Converter={StaticResource FloodingPercentageToDamageControlStringConverter}}">
                    <TextBlock.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="5,0"/>
                            <Setter Property="MinWidth" Value="50"/>
                            <Setter Property="Background" Value="{StaticResource Brush.TextBox.Background}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Compartments.FloodingPercentage, Converter={StaticResource FloodingPercentageToDamageControlIntegerConverter}}" Value="1"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundFocus}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Compartments.FloodingPercentage, Converter={StaticResource FloodingPercentageToDamageControlIntegerConverter}}" Value="2"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundEmphasis}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Compartments.FloodingPercentage, Converter={StaticResource FloodingPercentageToDamageControlIntegerConverter}}" Value="3"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundStrongEmphasis}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Compartments.FloodingPercentage, Converter={StaticResource FloodingPercentageToDamageControlIntegerConverter}}" Value="4"><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundReallyStrongEmphasis}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Resources>
                </TextBlock>
            </Grid>
        </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,0,0,6" Background="{StaticResource Brush.TextBox.Background}" BorderBrush="{StaticResource Brush.Border.Normal}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
                    <Setter Property="ItemTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <Grid MinHeight="21" Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}, Path=ActualWidth}" ClipToBounds="True">
                                    <TextBlock Margin="5,0" Text="{Binding Description}" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                    <Grid Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="5"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="2" Width="20" MinWidth="20" Height="20" Content="!" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Visibility="{Binding IsSystem, Converter={StaticResource CollapsedConverter}}" IsChecked="{Binding IsPriority}" ToolTip="{Binding DataContext.LanguageResourceHandler.LanguageDictionary[damagecontrolprioritytooltip], RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Prioritize this system for repair'}"/>
                                        <Border Grid.Column="0" Width="20" Height="20" Background="{StaticResource Brush.Button.BackgroundOver}" BorderBrush="{StaticResource Brush.Border.Normal}" BorderThickness="1" ToolTip="{Binding DataContext.LanguageResourceHandler.LanguageDictionary[damagecontrolrepairingtooltip], RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='This system is being repaired'}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRepairing, FallbackValue=False}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Path Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource Brush.TextBox.Foreground}" Data="M 1 17 C 5 11 10 16 4 20 C 8 20 9 18 9 14 L 14 9 C 18 9 20 8 20 4 C 16 10 11 5 17 1 C 13 1 12 3 12 7 L 7 12 C 3 12 1 13 1 17"/>
                                        </Border>
                                        <Border Grid.Column="0" Width="20" Height="20" Background="#33AA3333" BorderBrush="#33AA3333" BorderThickness="1" ToolTip="{Binding DataContext.LanguageResourceHandler.LanguageDictionary[damagecontroldestroyedtooltip], RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='System is destroyed and cannot be repaired'}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsUnrepairable, FallbackValue=False}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="X" Foreground="{StaticResource Brush.TextBox.ForegroundStrongEmphasis}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ListBoxItem}"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DamageIntensity}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding DamageIntensity}" Value="1"><Setter Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.Foreground}"/></DataTrigger>
                        <DataTrigger Binding="{Binding DamageIntensity}" Value="2"><Setter Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundEmphasis}"/></DataTrigger>
                        <DataTrigger Binding="{Binding DamageIntensity}" Value="3"><Setter Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundStrongEmphasis}"/></DataTrigger>
                        <DataTrigger Binding="{Binding DamageIntensity}" Value="4"><Setter Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource Brush.TextBox.ForegroundReallyStrongEmphasis}"/></DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Compartments.AutoDC}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding Compartments.AutoDC}" Value="False"><Setter Property="IsEnabled" Value="True"/></DataTrigger></Style.Triggers></Style>
            </Grid.Resources>
            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush.Border.Normal}"/>
            <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="4" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush.Border.Normal}"/>
            <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="4" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush.Border.Normal}"/>
            <Border Grid.Column="3" Grid.Row="0" Grid.RowSpan="4" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush.Border.Normal}"/>
            <TextBlock Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,4" Foreground="{StaticResource Brush.Foreground.Highlight}" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolaft], FallbackValue='Aft'}"/>
            <TextBlock Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,4" Foreground="{StaticResource Brush.Foreground.Highlight}" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolaftmidships], FallbackValue='Aft Midships'}"/>
            <TextBlock Grid.Column="2" Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,4" Foreground="{StaticResource Brush.Foreground.Highlight}" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolmidships], FallbackValue='Midships'}"/>
            <TextBlock Grid.Column="3" Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,4" Foreground="{StaticResource Brush.Foreground.Highlight}" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolforwardmidships], FallbackValue='Forward Midships'}"/>
            <TextBlock Grid.Column="4" Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,4" Foreground="{StaticResource Brush.Foreground.Highlight}" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolforward], FallbackValue='Forward'}"/>
            <Grid Grid.Column="4" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="-" Margin="5,0,0,0" Command="{Binding ReturnDamageControlTeam}" CommandParameter="0" ToolTip="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolmanualcontrol], FallbackValue='Return one team to reserve'}"/><TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Run Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontroldcteams], FallbackValue='DC Teams:'}"/><Run Text=" "/><Run Text="{Binding Compartments.DamageControlTeamsNumbers[0], FallbackValue=0}" Foreground="{StaticResource Brush.TextBox.ForegroundFocus}"/></TextBlock><Button Grid.Column="2" Content="+" Margin="0,0,5,0" Command="{Binding AssignDamageControlTeam}" CommandParameter="0" ToolTip="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolmanualcontrol], FallbackValue='Assign one team'}"/></Grid>
            <Grid Grid.Column="3" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="-" Margin="5,0,0,0" Command="{Binding ReturnDamageControlTeam}" CommandParameter="1" ToolTip="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolmanualcontrol], FallbackValue='Return one team to reserve'}"/><TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Run Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontroldcteams], FallbackValue='DC Teams:'}"/><Run Text=" "/><Run Text="{Binding Compartments.DamageControlTeamsNumbers[1], FallbackValue=0}" Foreground="{StaticResource Brush.TextBox.ForegroundFocus}"/></TextBlock><Button Grid.Column="2" Content="+" Margin="0,0,5,0" Command="{Binding AssignDamageControlTeam}" CommandParameter="1" ToolTip="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolmanualcontrol], FallbackValue='Assign one team'}"/></Grid>
            <Grid Grid.Column="2" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="-" Margin="5,0,0,0" Command="{Binding ReturnDamageControlTeam}" CommandParameter="2" ToolTip="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolmanualcontrol], FallbackValue='Return one team to reserve'}"/><TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Run Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontroldcteams], FallbackValue='DC Teams:'}"/><Run Text=" "/><Run Text="{Binding Compartments.DamageControlTeamsNumbers[2], FallbackValue=0}" Foreground="{StaticResource Brush.TextBox.ForegroundFocus}"/></TextBlock><Button Grid.Column="2" Content="+" Margin="0,0,5,0" Command="{Binding AssignDamageControlTeam}" CommandParameter="2" ToolTip="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolmanualcontrol], FallbackValue='Assign one team'}"/></Grid>
            <Grid Grid.Column="1" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="-" Margin="5,0,0,0" Command="{Binding ReturnDamageControlTeam}" CommandParameter="3" ToolTip="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolmanualcontrol], FallbackValue='Return one team to reserve'}"/><TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Run Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontroldcteams], FallbackValue='DC Teams:'}"/><Run Text=" "/><Run Text="{Binding Compartments.DamageControlTeamsNumbers[3], FallbackValue=0}" Foreground="{StaticResource Brush.TextBox.ForegroundFocus}"/></TextBlock><Button Grid.Column="2" Content="+" Margin="0,0,5,0" Command="{Binding AssignDamageControlTeam}" CommandParameter="3" ToolTip="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolmanualcontrol], FallbackValue='Assign one team'}"/></Grid>
            <Grid Grid.Column="0" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="-" Margin="5,0,0,0" Command="{Binding ReturnDamageControlTeam}" CommandParameter="4" ToolTip="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolmanualcontrol], FallbackValue='Return one team to reserve'}"/><TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Run Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontroldcteams], FallbackValue='DC Teams:'}"/><Run Text=" "/><Run Text="{Binding Compartments.DamageControlTeamsNumbers[4], FallbackValue=0}" Foreground="{StaticResource Brush.TextBox.ForegroundFocus}"/></TextBlock><Button Grid.Column="2" Content="+" Margin="0,0,5,0" Command="{Binding AssignDamageControlTeam}" CommandParameter="4" ToolTip="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolmanualcontrol], FallbackValue='Assign one team'}"/></Grid>
            <ListBox Grid.Column="4" Grid.Row="3" ItemsSource="{Binding DamageSummaries[0]}"/>
            <ListBox Grid.Column="3" Grid.Row="3" ItemsSource="{Binding DamageSummaries[1]}"/>
            <ListBox Grid.Column="2" Grid.Row="3" ItemsSource="{Binding DamageSummaries[2]}"/>
            <ListBox Grid.Column="1" Grid.Row="3" ItemsSource="{Binding DamageSummaries[3]}"/>
            <ListBox Grid.Column="0" Grid.Row="3" ItemsSource="{Binding DamageSummaries[4]}"/>
        </Grid>
        </Border>

        <Border Grid.Row="3" Padding="6,4" Background="{StaticResource Brush.TextBox.Background}" BorderBrush="{StaticResource Brush.Border.Normal}" BorderThickness="1">
