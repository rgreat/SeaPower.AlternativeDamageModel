                <TextBlock Foreground="{StaticResource Brush.Foreground.Highlight}" FontSize="{StaticResource Font.Size.ToolTip}" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolautodamagecontrolstatus], FallbackValue='Auto Damage Control Status'}"/>
                <TextBlock Margin="0,2,0,0" Text="{Binding Path=LanguageResourceHandler.LanguageDictionary[damagecontrolautopriorityexplanation], FallbackValue='Auto DC prioritizes threats in this order: Flooding Rate &gt; Fire &gt; Flooding &gt; Structure &gt; Systems'}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
